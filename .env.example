# System Environment
PROJECT_NAME=MORPHE
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000"]

# Database Configuration
POSTGRES_USER=morphe_user
POSTGRES_PASSWORD=morphe_secret_password
POSTGRES_DB=morphe_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://morphe_user:morphe_secret_password@postgres:5432/morphe_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# GROBID Configuration
GROBID_HOST=grobid
GROBID_PORT=8070
GROBID_URL=http://grobid:8070

# Storage Locations
ORIGINAL_INPUTS_DIR=storage_data/original
CDM_STORAGE_DIR=storage_data/cdm
ARTIFACTS_STORAGE_DIR=storage_data/artifacts

# Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8000
